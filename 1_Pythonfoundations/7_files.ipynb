   "source": [
    "from pathlib import Path\n",
    "import glob\n",
    "import os\n",
    "\n",
    "# 1. Create a folder and file path safely\n",
    "folder = Path(\"demo_folder\")\n",
    "folder.mkdir(exist_ok=True)\n",
    "\n",
    "file_path = folder / \"sample.txt\"\n",
    "\n",
    "# 2. Write to file\n",
    "with open(file_path, 'w', encoding='utf-8') as f:\n",
    "    f.write(\"Line 1\\n\")\n",
    "    f.write(\"Line 2\")\n",
    "\n",
    "# 3. Append to file\n",
    "with open(file_path, 'a', encoding='utf-8') as f:\n",
    "    f.write(\"\\nLine 3 (appended)\")\n",
    "\n",
    "# 4. Read file line by line\n",
    "print(\"Reading file:\")\n",
    "with open(file_path, 'r', encoding='utf-8') as f:\n",
    "    for line in f:\n",
    "        print(line.strip())\n",
    "\n",
    "# 5. List all .txt files using glob\n",
    "print(\"\\nAll TXT files:\")\n",
    "print(glob.glob(\"**/*.txt\", recursive=True))\n",
    "\n",
    "# 6. Check if file exists using pathlib\n",
    "if file_path.exists():\n",
    "    print(\"\\nFile exists at:\", file_path.resolve()) # resolve()-Make the path absolute"
   ]
  }
